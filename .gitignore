# Portable Processing IDE — re-downloadable from processing.org
/Processing/

# Android SDK, emulator images, platform tools — re-installable via sdkmanager
/android-build/sdk/

# AndroidMode release — re-downloadable from processing/processing-android
/android-build/AndroidMode/

# AndroidX source aars, extracted res, and scratch area.
# The build inputs (androidx/classes/*.jar, androidx/compiled/*.zip) ARE tracked.
/android-build/androidx/aars/
/android-build/androidx/res/
/android-build/androidx/x/

# Exploded Android core classes — processing-core.jar is tracked instead
/android-build/core/processing/
/android-build/core/META-INF/

# Generated build intermediates — regenerated by the full pipeline in ANDROID.md
# (a fresh clone must run ANDROID.md steps 1-2 once before build.bat works)
/android-build/project/classes/
/android-build/project/dex/
/android-build/project/gen/
/android-build/project/tmpman/
/android-build/project/stage/
/android-build/project/sketch.jar
/android-build/project/base.apk
/android-build/project/ids.txt
/android-build/project/dir_placeholder

# Build output — the shipped copy lives at the workspace root
/android-build/project/FractalTree.apk

# Emulator / sdkmanager logs
/android-build/*.log

# Gradle distribution and build caches (the wrapper + build files ARE tracked)
/android-build/gradle-8.9*
/android/.gradle/
/android/app/build/
/android/local.properties

